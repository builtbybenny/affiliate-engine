[TEMPLATE]
# ── Copy this file to .env and fill in values ─────────────────────────
# Never commit .env to git. setup_tokens.py fills most of this for you.

# Numeric Instagram Business account ID (filled by setup_tokens.py)
IG_USER_ID=

# Numeric Facebook Page ID (filled by setup_tokens.py)
FB_PAGE_ID=

# Access token (filled by setup_tokens.py). Page tokens from the wizard never expire.
ACCESS_TOKEN=

# Graph API version
GRAPH_VERSION=v23.0

# Branding (prefilled — @stackandsave on IG + FB)
BRAND_NAME=Stack & Save
BRAND_HANDLE=@stackandsave
NICHE=saas_tools

# Timezone offset of your posting schedule, e.g. "+05:30" for India
TZ_OFFSET=+05:30

# Public URL serving public/ (GitHub Pages or a tunnel), no trailing slash.
# Example: https://youruser.github.io/affiliate-engine
PUBLIC_MEDIA_BASE_URL=

# Local: for Fernet-encrypting the token for CI (auto-generated by setup_tokens.py)
TOKEN_ENCRYPTION_KEY=

# OPTIONAL: AI copywriter (free tier, no card) - https://aistudio.google.com/app/apikey
# Leave empty to use built-in template copy. Never blocks posting.
GEMINI_API_KEY=

# OPTIONAL: stock photo backgrounds (free tier, no card) - https://www.pexels.com/api/
# Leave empty to render slides on branded gradients. Never blocks posting.
PEXELS_API_KEY=
